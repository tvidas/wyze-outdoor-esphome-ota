# Copy to secrets.yaml (gitignored) and fill in. These are compiled INTO the
# firmware image, which is why run/ and .esphome/ are gitignored too.

# Home wifi name - REQUIRED because once ESPHome boots it leaves the laptop AP
# and joins this network; it's the first real network the plug ever touches.
# Must be 2.4 GHz and reachable from Home Assistant.
wifi_ssid: "YOUR_HOME_WIFI"

# Home wifi password - REQUIRED because the plug has no screen or app to enter
# it later; it must be baked into the image to get online.
wifi_password: "YOUR_HOME_WIFI_PASSWORD"

# API encryption key - REQUIRED because Home Assistant talks to the plug over
# an encrypted link; HA asks for this key once when you add the device.
# Generate it, don't invent it:  openssl rand -base64 32
api_key: "PASTE_OUTPUT_OF: openssl rand -base64 32"

# OTA password - REQUIRED because it stops anyone on your network from pushing
# their own firmware to the plug; you (or the ESPHome add-on) need it for every
# future update. Keep a backup - without it, updates need a serial adapter.
ota_password: "choose-anything"

# Fallback hotspot password - REQUIRED because if the plug can't join your
# wifi it opens its own "wyze-outdoor-plug fallback" hotspot with a setup page;
# this keeps strangers from connecting to it. Min 8 characters.
fallback_password: "choose-8plus-chars"

# Web page password - REQUIRED because the troubleshooting page at
# http://wyze-outdoor-XXXXXX.local can switch the outlets; without auth anyone
# on your wifi could. Username is "admin".
web_password: "choose-anything"
