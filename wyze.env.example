# Copy to wyze.env (gitignored, chmod 600) and fill in. All four are required
# for the FIRST login only; afterwards run/.wyze_token is used and this file
# can be deleted. Leave a field "" to be prompted for it instead.

# Wyze account email - REQUIRED because the "upgrade" command can only be sent
# to plugs registered to an account, and login identifies that account.
WYZE_USER="you+wyze@example.com"

# Wyze account password - REQUIRED because Wyze's login (/api/user/login) needs
# email + password together to issue the access token; the API key alone can't.
WYZE_PASSWORD="throwaway-account-password"

# Developer Key ID - REQUIRED because since 2025 Wyze rejects logins from tools
# that don't present a registered developer key (developer-api-console.wyze.com).
WYZE_KEY_ID="from developer-api-console.wyze.com"

# Developer API Key - REQUIRED because it is the secret half of the Key ID
# above; Wyze checks the pair together on every login.
WYZE_API_KEY="from developer-api-console.wyze.com"
