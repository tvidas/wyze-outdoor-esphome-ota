# ===== EDIT THESE before running anything =====

# Wi-Fi interface that will BECOME the access point the plug joins.
# auto = first wireless interface (iw dev). Or set it, e.g. "wlan0" / "wlp2s0".
WIFI_IF="auto"

# Interface with REAL internet (USB phone tether or ethernet), used for the
# Wyze cloud trigger. auto = whatever holds the default route (tethers rename
# themselves when they reconnect). Or set it, e.g. "usb0" / "enp0s31f6".
UPLINK_IF="auto"
